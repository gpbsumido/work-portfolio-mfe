{
  "name": "work-portfolio-mfe",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@8.5.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "dev": "pnpm --filter @paul-portfolio/work-portfolio-contract build && pnpm --filter work-portfolio-remote dev",
    "test": "pnpm --filter @paul-portfolio/work-portfolio-contract build && pnpm -r test",
    "typecheck": "pnpm --filter @paul-portfolio/work-portfolio-contract build && pnpm -r typecheck",
    "test:e2e": "pnpm --filter work-portfolio-remote test:e2e"
  }
}
